# fitness_workout_app Environment Configuration
#
# SECURITY: API keys must NEVER be stored in client-side code.
# This app uses Firebase and Google Generative AI.
#
# Required environment variables:
# GEMINI_API_KEY=your_google_generative_ai_key_here
#
# Build with:
# flutter run --dart-define=GEMINI_API_KEY=your_key_here
